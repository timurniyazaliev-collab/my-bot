# Скопируйте в madeinside/.env и заполните.

ANTHROPIC_API_KEY=

PEXELS_API_KEY=
# У Videvo нет стабильного публичного API — см. README, клипы оттуда
# докачиваются вручную.
VIDEVO_API_KEY=

# elevenlabs (по умолчанию) или google
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# нужен только при TTS_PROVIDER=google:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# horizontal (1920x1080) или vertical (1080x1920)
TARGET_ORIENTATION=horizontal

# опционально: дорожка фоновой музыки (royalty-free, скачать вручную)
MUSIC_PATH=

# YouTube OAuth — скачайте client_secret.json из Google Cloud Console
# (OAuth client, тип Desktop app) и положите в madeinside/
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
